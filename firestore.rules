rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the existing application policy while denying all client access
    // to Cloud Functions' AI quota counters. Admin SDK access bypasses rules.
    // TODO: Audit the existing public application policy separately.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'courseAIUsage';
    }
  }
}
