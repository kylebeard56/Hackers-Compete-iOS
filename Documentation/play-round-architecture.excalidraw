      "isDeleted": false,
      "boundElements": [],
      "updated": 1755603847039,
      "link": null,
      "locked": false,
      "text": "GameScope\n----------\nAttribute that defines whether this game is for the\ngroup-only (Cards of Chaos, Bingo Bango Bongo) or for\nthe global party.\n\nGlobal - used for leaderboard (stroke play, fourball,\nbest ball, capt choice, Vegas)\n\nGroup - used only within group (Bingo Bango Bongo,\nCards of Chaos, Skins)\n\nProposition - used as side pot from leaderboard\n(closest to pin, birdie pool, junk)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "deO4QkU-aD0kgm5dAgolF",
      "originalText": "GameScope\n----------\nAttribute that defines whether this game is for the group-only (Cards of Chaos, Bingo Bango Bongo) or for the global party.\n\nGlobal - used for leaderboard (stroke play, fourball, best ball, capt choice, Vegas)\n\nGroup - used only within group (Bingo Bango Bongo, Cards of Chaos, Skins)\n\nProposition - used as side pot from leaderboard (closest to pin, birdie pool, junk)",
      "autoResize": true,
      "lineHeight": 1.25
    },
