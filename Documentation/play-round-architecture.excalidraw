      "isDeleted": false,
      "boundElements": [],
      "updated": 1755603847039,
      "link": null,
      "locked": false,
      "text": "LeaderboardManager\n----------\nMainActor that handles all calculation of the global format and gameplay\nthroughout the round for only the leaderboard. Limited to stroke play,\nmatch play, nassau, stableford, vegas, etc. \n\nWon't ever manage Bingo Bango Bongo, Cards of Chaos, etc as these are\ngroup-specific SideGames.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "FSrdfDJsuiPo6s7v5tZSU",
      "originalText": "LeaderboardManager\n----------\nMainActor that handles all calculation of the global format and gameplay throughout the round for only the leaderboard. Limited to stroke play, match play, nassau, stableford, vegas, etc. \n\nWon't ever manage Bingo Bango Bongo, Cards of Chaos, etc as these are group-specific SideGames.",
      "autoResize": true,
      "lineHeight": 1.25
    },
