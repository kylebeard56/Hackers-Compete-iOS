default_platform(:ios)

platform :ios do
  desc "Archive, upload to TestFlight, set compliance, and distribute to Beta Testers"
  lane :deploy_testflight do
    group = ENV["EXTERNAL_GROUP"] || "Beta Testers"
    changelog = ENV["CHANGELOG"]
    api_key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_P8"]

    export_opts = {
      method: "app-store",
      teamID: "28EF5GR4R6",
      signingStyle: "automatic"
    }
    # If automatic profile detection fails, set EXPORT_PROVISIONING_PROFILE_NAME to your
    # App Store profile name (from Xcode > Signing & Capabilities or developer.apple.com)
    if ENV["EXPORT_PROVISIONING_PROFILE_NAME"]
      export_opts[:provisioningProfiles] = {
        "com.tigermindlabs.hackers.compete" => ENV["EXPORT_PROVISIONING_PROFILE_NAME"]
      }
    end

    gym(
      scheme: "Production",
      export_method: "app-store",
      export_options: export_opts,
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates",
      output_directory: "./build",
      output_name: "Hackers.ipa",
      clean: true
    )

    upload_params = {
      ipa: "./build/Hackers.ipa",
      skip_waiting_for_build_processing: false,
      uses_non_exempt_encryption: false,
      distribute_external: true,
      groups: [group],
      submit_beta_review: true,
      changelog: changelog
    }

    if api_key_path
      if File.extname(api_key_path).downcase == ".json"
        upload_params[:api_key_path] = api_key_path
      else
        key_id = ENV["APP_STORE_CONNECT_KEY_ID"] || ENV["KEY_ID"]
        issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || ENV["ISSUER_ID"]
        UI.user_error!("Missing KEY_ID/ISSUER_ID for App Store Connect API key (.p8).") if key_id.to_s.empty? || issuer_id.to_s.empty?

        upload_params[:api_key] = app_store_connect_api_key(
          key_id: key_id,
          issuer_id: issuer_id,
          key_filepath: api_key_path
        )
      end
    end

    upload_to_testflight(upload_params)
  end
end
